Bootstrap: docker
from: debian:bookworm

%post
    apt update
    apt install -y wget python3
    cd /opt
    wget https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.38/quarto-1.9.38-linux-amd64.deb
    apt install -y ./quarto-1.9.38-linux-amd64.deb


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
