Bootstrap: docker
From: rockylinux:8.9.20231119

%post
  yum update -y
  yum install -y wget tar
  cd /opt
  wget https://dalexander.github.io/admixture/binaries/admixture_linux-1.4.0.tar.gz
  tar xzf admixture_linux-1.4.0.tar.gz

%environment
  export PATH="/opt/admixture_linux-1.4.0:$PATH"

%labels
  author Jenny Fothergill <jennyfothergill@boisestate.edu>
  github.com/bsurc/container git rev={{GIT_REV}}
