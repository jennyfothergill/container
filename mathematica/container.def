Bootstrap: docker
From: almalinux:10-kitten-20260902

%files
    Wolfram_14.1.0_LIN.sh /opt

%environment
    export LC_ALL=C.UTF-8

%post
    dnf install -y epel-release
    dnf config-manager --enable crb
    dnf install -y yum
    yum update -y
    yum install -y xz \
        findutils \
        ncurses \
        fontconfig \
        freetype \
        libX11 \
        libxcb \
        libXext \
        libxkbcommon \
        libxkbcommon-x11 \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm \
        mesa-libGL \
        mesa-libGL-devel \
        alsa-lib \
        libglvnd-egl \
        qt6-qtbase
    bash /opt/Wolfram_14.1.0_LIN.sh \
        -- -auto \
        -createdir=y \
        -execdir=/usr/local/bin \
        -method=Full \
        -overwrite=y \
        -targetdir=/usr/local/Wolfram/Mathematica/14.0 \
        -silent

    rm /opt/Wolfram_14.1.0_LIN.sh


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
