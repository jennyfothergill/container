Bootstrap: docker
From: stateoftheartio/qt6:6.10-gcc-aqt

%files
    Wolfram_14.1.0_LIN.sh /opt

%environment
    export LC_ALL=C.UTF-8
    export TZ=America/Boise

%post
    apt update -y
    apt install -y \
        libfontconfig1 \
        libfreetype6 \
        libx11-6 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-xfixes0 \
        libxcb1 \
        libxext6 \
        libxinerama1 \
        libxkbcommon-x11-0 \
        libxkbcommon0 \
        libasound2t64 \
        libpng16-16t64 \
        libjpeg8

    # Install Mathematica
    bash /opt/Wolfram_14.1.0_LIN.sh \
        -- -auto \
        -createdir=y \
        -execdir=/usr/local/bin \
        -method=Full \
        -overwrite=y \
        -targetdir=/usr/local/Wolfram/Mathematica/14.0 \
        -silent

    rm /opt/Wolfram_14.1.0_LIN.sh


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
