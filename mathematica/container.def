Bootstrap: docker
From: rockylinux:9.3.20231119

%files
    Wolfram_14.1.0_LIN.sh /opt

%environment
    export LC_ALL=C.UTF-8
    export LD_LIBRARY_PATH=/usr/local/Qt-6.12.0/lib:$LD_LIBRARY_PATH

%post
    dnf install -y epel-release
    dnf config-manager --enable crb
    yum update -y
    yum install -y xz \
        findutils \
        ncurses \
        freetype \
        mesa-libGL \
        mesa-libGL-devel \
        fontconfig \
        alsa-lib \
        libxkbcommon \
        libglvnd-egl \
        git \
        cmake \
        ninja-build \
        python3 \
        gcc \
        gcc-c++
    # build qt...
    cd /opt
    git clone --branch v6.12.0 git://code.qt.io/qt/qt5.git qt
    cd qt
    ./init-repository --module-subset=essential
    mkdir build
    cd build
    ../configure
    cmake --build . --parallel
    cmake --install .
    bash /opt/Wolfram_14.1.0_LIN.sh \
        -- -auto \
        -createdir=y \
        -execdir=/usr/local/bin \
        -method=Full \
        -overwrite=y \
        -targetdir=/usr/local/Wolfram/Mathematica/14.0 \
        -silent

    rm /opt/Wolfram_14.1.0_LIN.sh
    rm -rf /opt/qt


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
