Bootstrap: docker
From: stateoftheartio/qt6:6.10-gcc-aqt

%files
    Wolfram_14.1.0_LIN.sh /opt

%environment
    export LC_ALL=C.UTF-8

%post
    dnf install -y epel-release
    dnf config-manager --enable epel
    dnf install -y yum-utils yum
    yum update -y
    yum install -y \
        fontconfig \
        freetype \
        libX11 \
        libxcb \
        libXext \
        libxkbcommon \
        libxkbcommon-x11 \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm 

    # Install Mathematica
    bash /opt/Wolfram_14.1.0_LIN.sh \
        -- -auto \
        -createdir=y \
        -execdir=/usr/local/bin \
        -method=Full \
        -overwrite=y \
        -targetdir=/usr/local/Wolfram/Mathematica/14.0 \
        -silent

    rm /opt/Wolfram_14.1.0_LIN.sh


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
