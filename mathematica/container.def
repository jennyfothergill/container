Bootstrap: docker
From: almalinux:8.10-20260902

%files
    Wolfram_14.1.0_LIN.sh /opt

%environment
    export LC_ALL=C.UTF-8

%post
    dnf install -y epel-release
    dnf config-manager --enable epel
    dnf install -y yum-utils yum
    dnf config-manager --set-enabled powertools
    yum update -y
    yum install -y xz \
        findutils \
        ncurses \
        fontconfig \
        freetype \
        libX11 \
        libxcb \
        libXext \
        libxkbcommon \
        libxkbcommon-x11 \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm \
        mesa-libGL \
        mesa-libGL-devel \
        alsa-lib \
        libglvnd-egl \
        libpng \
        libjpeg \
        git \
        cmake \
        ninja-build \
        python3 \
        gcc \
        gcc-c++

    # fix rdseed32 error?
    sed -i '27i #include <x86intrin.h>' /usr/lib/gcc/x86_64-redhat-linux/8/include/rdseedintrin.h 
    # build qt...
    cd /opt
    git clone --branch v6.12.0 git://code.qt.io/qt/qt5.git qt
    cd qt
    ./init-repository --module-subset=essential
    mkdir build
    cd build
    ../configure
    cmake --build . --parallel
    cmake --install .
    bash /opt/Wolfram_14.1.0_LIN.sh \
        -- -auto \
        -createdir=y \
        -execdir=/usr/local/bin \
        -method=Full \
        -overwrite=y \
        -targetdir=/usr/local/Wolfram/Mathematica/14.0 \
        -silent

    rm /opt/Wolfram_14.1.0_LIN.sh


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
