Bootstrap: localimage
From: container.sif

%environment
    export LC_ALL=C.UTF-8
    export LD_LIBRARY_PATH=/usr/local/Qt-6.12.0/lib:$LD_LIBRARY_PATH

%post
    rm -rf /opt/qt
    yum install -y libX11 \
        libxcb \
        libXext \
        libxkbcommon-x11 \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm


%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
