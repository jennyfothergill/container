bootstrap: docker
from: rockylinux:8.9.20231119

%environment
    export LC_ALL=C

%post
    yum update -y
    yum install -y \
        curl
    export PIXI_HOME=/opt/.pixi
    export PIXI_NO_PATH_UPDATE=true
    curl -fsSL https://pixi.sh/install.sh | sh
    export PATH=/opt/.pixi/bin:$PATH
    pixi --version

%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
