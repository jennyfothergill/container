bootstrap: docker
from: ubuntu:jammy-20260930

%environment
    export LC_ALL=C
    export SCHRODINGER=/opt/schrodinger
    export SCHRODINGER_PYTHONPATH=""
    export PATH=/opt/schrodinger:$PATH

%files
    schrodinger_suites.tar /opt/schrodinger_suites.tar

%post
    apt update -y
    apt install -y \
        binutils \
        tar \
        libcups2 \
        libcrypt1 \
        libdrm2 \
        libfontconfig1 \
        libglu1-mesa \
        libice6 \
        libsm6 \
        libtirpc3 \
        libx11-6 \
        libx11-xcb1 \
        libxau6 \
        libxcb-cursor0 \
        libxcb-glx0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-render0 \
        libxcb-shape0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-util1 \
        libxcb-xfixes0 \
        libxcb-xkb1 \
        libxcb1 \
        libxdmcp6 \
        libxext6 \
        libxft2 \
        libxi6 \
        libxkbcommon-x11-0 \
        libxkbcommon0 \
        libxrender1 \
        libxss1 \
        libxt6 \
        mesa-utils \
        libglib2.0-dev
    cd /opt
    mkdir schrodinger
    tar -xf schrodinger_suites.tar
    cd /opt/Schrodinger_Suites_2026-3_Linux-x86_64/
    sh ./INSTALL -k /tmp -s /opt/schrodinger -b -d /opt/Schrodinger_Suites_2026-3_Linux-x86_64 -t /opt/schrodinger/thirdparty --preferences-location installation *
    rm -rf /opt/schrodinger_suites.tar /opt/Schrodinger_Suites_2026-3_Linux-x86_64/
    strip --remove-section=.note.ABI-tag /opt/schrodinger/mmshare-v7.5/lib/Linux-x86_64/libQt6Core.so.6

%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
