bootstrap: docker
from: rockylinux:9.3.20231119

%environment
    export LC_ALL=C
    export SCHRODINGER=/opt/schrodinger
    export SCHRODINGER_PYTHONPATH=""
    export PATH=/opt/schrodinger:$PATH
    export LD_LIBRARY_PATH=/lib64:$LD_LIBRARY_PATH

%files
    schrodinger_suites.tar /opt/schrodinger_suites.tar

%post
    yum update -y
    yum install -y epel-release
    yum install -y \
        tar \
        cups-libs \
        expat \
        fontconfig \
        glx-utils \
        libICE \
        libSM \
        libX11 \
        libX11-xcb \
        libXScrnSaver \
        libXau \
        libXext \
        libXft \
        libXi \
        libXrender \
        libXt \
        libdrm \
        libuuid \
        libxcrypt \
        libxcb \
        libxkbcommon \
        libxkbcommon-x11 \
        mesa-libGLU \
        nfs-utils \
        qt6-qtbase \
        xcb-util \
        xcb-util-cursor \
        xcb-util-image \
        xcb-util-keysyms \
        xcb-util-renderutil \
        xcb-util-wm
    cd /opt
    mkdir schrodinger
    tar -xf schrodinger_suites.tar
    cd /opt/Schrodinger_Suites_2026-3_Linux-x86_64/
    sh ./INSTALL -k /tmp -s /opt/schrodinger -b -d /opt/Schrodinger_Suites_2026-3_Linux-x86_64 -t /opt/schrodinger/thirdparty --preferences-location installation *
    rm -rf /opt/schrodinger_suites.tar /opt/Schrodinger_Suites_2026-3_Linux-x86_64/

%labels
    author Jenny Fothergill <jennyfothergill@boisestate.edu>
    github.com/bsurc/container git rev={{GIT_REV}}
